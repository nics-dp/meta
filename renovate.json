{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nics-dp/meta:renovate-preset"
  ],
  "github-actions": {
    "managerFilePatterns": [
      ".github/workflows/**"
    ]
  },
  "packageRules": [
    {
      "description": "Review Zizmor action, CLI, and image support together",
      "groupName": "zizmor security gate",
      "matchPackageNames": [
        "zizmorcore/zizmor-action",
        "zizmorcore/zizmor"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Review Anchore scan action and Grype together where they gate a workflow; the Grype pins in the mise atoms have their own rule below",
      "groupName": "grype path security gate",
      "matchPackageNames": [
        "anchore/scan-action",
        "anchore/grype"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep synchronized mise pins in one update",
      "groupName": "mise version pins",
      "matchPackageNames": [
        "jdx/mise"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Scanner binaries: pinned for reproducibility and supply-chain review, refreshed on this rule's schedule with a short release-age buffer and automerged. Detection freshness comes from the databases and rule packs the scanners fetch at run time (trivy-db, grype-db, the opengrep registry); trufflehog's detectors ship in the binary, which is why this group runs more often than the preset's weekly default. opengrep and trufflehog reach this rule through the org preset's mise task-header manager, trivy through meta's own.",
      "matchPackageNames": [
        "aquasecurity/trivy",
        "opengrep/opengrep",
        "trufflesecurity/trufflehog"
      ],
      "groupName": "security scanners",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "before 5am"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Grype in the mise scan atoms follows the security scanners policy; the workflow-side Grype, which gates ci.yml, stays under the grype path security gate rule. The two rules are disjoint by file pattern, so neither depends on ordering.",
      "matchPackageNames": [
        "anchore/grype"
      ],
      "matchFileNames": [
        ".mise/tasks/**"
      ],
      "groupName": "security scanners",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "before 5am"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Go analysis tools used by the go:audit / go:dead-code / go:bench-compare atoms and the SARIF workflow open as one PR and keep the preset's review (no automerge): deadcode and benchstat ride x/tools and x/perf, whose minor releases can change analysis results or fail on new language features, so a bump needs a human look.",
      "groupName": "go analysis tools",
      "matchPackageNames": [
        "golang.org/x/vuln",
        "golang.org/x/tools",
        "golang.org/x/perf"
      ],
      "automerge": false
    },
    {
      "description": "parlay is pinned in two forms — the atoms' github:snyk/parlay header (matched by the org preset) and the SBOM workflows' go install line (matched by meta's manager); one group moves both in one PR and keeps the preset's review.",
      "matchPackageNames": [
        "snyk/parlay"
      ],
      "groupName": "parlay pins",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Bun default used by production dependency submission and its extracted-helper tests",
      "managerFilePatterns": [
        "/^\\.github/workflows/node-dependency-submission\\.yml$/"
      ],
      "matchStrings": [
        "bun_version:[\\s\\S]*?default: \\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the released Syft version used for production dependency graph normalization",
      "managerFilePatterns": [
        "/^\\.github/workflows/node-dependency-submission\\.yml$/"
      ],
      "matchStrings": [
        "syft-version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update quill version in go-release workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/go-release\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/anchore/quill/cmd/quill@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anchore/quill",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the parlay go install lines in the SBOM workflows; the atoms' github:snyk/parlay header pins are matched by the org preset's mise task-header manager, and the parlay pins package rule below groups both into one PR",
      "managerFilePatterns": [
        "/^\\.github/workflows/sbom-(?:source|image)\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/snyk/parlay@v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "snyk/parlay",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update synchronized mise pins: the mise-task reusable workflow, auto-release.yml's mise_version input default, and self-release.yml's explicit pass",
      "managerFilePatterns": [
        "/^\\.github/workflows/mise-task\\.yml$/",
        "/^\\.github/workflows/auto-release\\.yml$/",
        "/^\\.github/workflows/self-release\\.yml$/"
      ],
      "matchStrings": [
        "jdx/mise-action@[\\s\\S]*?version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "mise_version:[\\s\\S]*?default:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "mise_version:[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the ShellCheck pin in the mise task lint atom",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/shellcheck$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{shellcheck=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update synchronized Zizmor CLI pins in the audit atom and official action input",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/zizmor$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{zizmor=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"\\}",
        "uses:[ \\t]*zizmorcore/zizmor-action@[0-9a-f]{40}[^\\n]*\\n        with:\\n(?:          [^\\n]*\\n)*?          version:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the Grype version in the blocking path scan",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "grype-version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update synchronized gosec pins in the SARIF workflow and local SAST task",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-sarif\\.yml$/",
        "/^\\.mise/tasks/go/sast$/"
      ],
      "matchStrings": [
        "go install github\\.com/securego/gosec/v2/cmd/gosec@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "#MISE tools=\\{\\\"github:securego/gosec\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "securego/gosec",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update synchronized govulncheck pins in the security-sarif workflow and the go:audit task",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-sarif\\.yml$/",
        "/^\\.mise/tasks/go/audit$/"
      ],
      "matchStrings": [
        "go install golang\\.org/x/vuln/cmd/govulncheck@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "#MISE tools=\\{\\\"go:golang\\.org/x/vuln/cmd/govulncheck\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update air (air-verse/air) version in the go:dev mise task (tools header + config-free fallback)",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/dev$/"
      ],
      "matchStrings": [
        "go:github\\.com/air-verse/air\"=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "go install github\\.com/air-verse/air@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "air-verse/air",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the deadcode pin (golang.org/x/tools) in the go:dead-code task",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/dead-code$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{\\\"go:golang\\.org/x/tools/cmd/deadcode\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/tools",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track the benchstat pin (golang.org/x/perf) in the go:bench-compare task; x/perf publishes pseudo-versions only, so this mostly documents the dependency",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/bench-compare$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{\\\"go:golang\\.org/x/perf/cmd/benchstat\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-\\d{14}-[0-9a-f]{12})?)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/perf",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update synchronized Trivy pins: the core `trivy=` tool in the mise scan atoms (the org preset's header manager only sees aqua:/github: tools) and the trivy-action `version:` input in the SBOM and SARIF workflows",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/trivy$/",
        "/^\\.mise/tasks/ci/trivy-license$/",
        "/^\\.mise/tasks/sbom/trivy$/",
        "/^\\.mise/tasks/py/sbom-custom$/",
        "/^\\.github/workflows/sbom-(?:source|image)\\.yml$/",
        "/^\\.github/workflows/security-sarif\\.yml$/"
      ],
      "matchStrings": [
        "trivy=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"",
        "uses:[ \\t]*aquasecurity/trivy-action@[0-9a-f]{40}[^\\n]*\\n        with:\\n          version:[ \\t]*v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the core `grype=` tool in the mise scan atoms (not visible to the org preset's aqua:/github: header manager)",
      "managerFilePatterns": [
        "/^\\.mise/tasks/sbom/grype$/",
        "/^\\.mise/tasks/py/sbom-custom$/"
      ],
      "matchStrings": [
        "grype=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
