{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>nics-dp/meta:renovate-preset"
  ],
  "github-actions": {
    "managerFilePatterns": [
      ".github/workflows/**"
    ]
  },
  "packageRules": [
    {
      "description": "Review Zizmor action, CLI, and image support together",
      "groupName": "zizmor security gate",
      "matchPackageNames": [
        "zizmorcore/zizmor-action",
        "zizmorcore/zizmor"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Review Anchore scan action and Grype together",
      "groupName": "grype path security gate",
      "matchPackageNames": [
        "anchore/scan-action",
        "anchore/grype"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep synchronized mise pins in one update",
      "groupName": "mise version pins",
      "matchPackageNames": [
        "jdx/mise"
      ],
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Scanner binaries: pinned for reproducibility and supply-chain review, refreshed daily with a short release-age buffer and automerged. Detection freshness comes from the databases and rule packs the scanners fetch at run time (trivy-db, grype-db, the opengrep registry); trufflehog's detectors ship in the binary, which is why this group runs daily rather than weekly.",
      "matchPackageNames": [
        "aquasecurity/trivy",
        "opengrep/opengrep",
        "trufflesecurity/trufflehog"
      ],
      "groupName": "security scanners",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "before 5am"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Grype in the mise scan atoms joins the daily scanner group; the blocking `grype-path` scan in ci.yml keeps the reviewed 7-day gate above (placed after it to override for the atoms only).",
      "matchPackageNames": [
        "anchore/grype"
      ],
      "matchFileNames": [
        ".mise/tasks/**"
      ],
      "groupName": "security scanners",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "before 5am"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Go analysis tools used by the go:audit / go:dead-code / go:bench-compare atoms and the SARIF workflow open as one PR; deadcode has broken on a minor x/tools bump before, so this group keeps the preset's review (no automerge).",
      "groupName": "go analysis tools",
      "matchPackageNames": [
        "golang.org/x/vuln",
        "golang.org/x/tools",
        "golang.org/x/perf"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update quill version in go-release workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/go-release\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/anchore/quill/cmd/quill@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anchore/quill",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update parlay version in SBOM workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/sbom-(?:source|image)\\.yml$/"
      ],
      "matchStrings": [
        "go install github\\.com/snyk/parlay@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "snyk/parlay",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update synchronized mise pins: the mise-task reusable workflow, auto-release.yml's mise_version input default, and self-release.yml's explicit pass",
      "managerFilePatterns": [
        "/^\\.github/workflows/mise-task\\.yml$/",
        "/^\\.github/workflows/auto-release\\.yml$/",
        "/^\\.github/workflows/self-release\\.yml$/"
      ],
      "matchStrings": [
        "jdx/mise-action@[\\s\\S]*?version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "mise_version:[\\s\\S]*?default:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "mise_version:[ \\t]*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the ShellCheck pin in the mise task lint atom",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/shellcheck$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{shellcheck=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update synchronized Zizmor CLI pins in the audit atom and official action input",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/zizmor$/",
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{zizmor=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"\\}",
        "uses:[ \\t]*zizmorcore/zizmor-action@[0-9a-f]{40}[^\\n]*\\n        with:\\n(?:          [^\\n]*\\n)*?          version:[ \\t]*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "zizmorcore/zizmor",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the Grype version in the blocking path scan",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "grype-version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update synchronized gosec pins in the SARIF workflow and local SAST task",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-sarif\\.yml$/",
        "/^\\.mise/tasks/go/sast$/"
      ],
      "matchStrings": [
        "go install github\\.com/securego/gosec/v2/cmd/gosec@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "#MISE tools=\\{\\\"github:securego/gosec\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "securego/gosec",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update synchronized govulncheck pins in the security-sarif workflow and the go:audit task",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-sarif\\.yml$/",
        "/^\\.mise/tasks/go/audit$/"
      ],
      "matchStrings": [
        "go install golang\\.org/x/vuln/cmd/govulncheck@(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "#MISE tools=\\{\\\"go:golang\\.org/x/vuln/cmd/govulncheck\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update air (air-verse/air) version in the go:dev mise task (tools header + config-free fallback)",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/dev$/"
      ],
      "matchStrings": [
        "go:github\\.com/air-verse/air\"=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"",
        "go install github\\.com/air-verse/air@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "air-verse/air",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the deadcode pin (golang.org/x/tools) in the go:dead-code task",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/dead-code$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{\\\"go:golang\\.org/x/tools/cmd/deadcode\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/tools",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track the benchstat pin (golang.org/x/perf) in the go:bench-compare task; x/perf publishes pseudo-versions only, so this mostly documents the dependency",
      "managerFilePatterns": [
        "/^\\.mise/tasks/go/bench-compare$/"
      ],
      "matchStrings": [
        "#MISE tools=\\{\\\"go:golang\\.org/x/perf/cmd/benchstat\\\"=\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-\\d{14}-[0-9a-f]{12})?)\\\"\\}"
      ],
      "depNameTemplate": "golang.org/x/perf",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update synchronized Trivy pins: the mise scan atoms and the trivy-action `version:` input in the SBOM and SARIF workflows",
      "managerFilePatterns": [
        "/^\\.mise/tasks/iac/trivy$/",
        "/^\\.mise/tasks/ci/trivy-license$/",
        "/^\\.mise/tasks/sbom/trivy$/",
        "/^\\.mise/tasks/py/sbom-custom$/",
        "/^\\.github/workflows/sbom-(?:source|image)\\.yml$/",
        "/^\\.github/workflows/security-sarif\\.yml$/"
      ],
      "matchStrings": [
        "trivy=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\"",
        "uses:[ \\t]*aquasecurity/trivy-action@[0-9a-f]{40}[^\\n]*\\n        with:\\n          version:[ \\t]*v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the Grype pins in the mise scan atoms",
      "managerFilePatterns": [
        "/^\\.mise/tasks/sbom/grype$/",
        "/^\\.mise/tasks/py/sbom-custom$/"
      ],
      "matchStrings": [
        "grype=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "anchore/grype",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the OpenGrep pin in the ci:semgrep task",
      "managerFilePatterns": [
        "/^\\.mise/tasks/ci/semgrep$/"
      ],
      "matchStrings": [
        "\\\"aqua:opengrep/opengrep\\\"=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "opengrep/opengrep",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the TruffleHog pin in the ci:trufflehog task",
      "managerFilePatterns": [
        "/^\\.mise/tasks/ci/trufflehog$/"
      ],
      "matchStrings": [
        "\\\"aqua:trufflesecurity/trufflehog\\\"=\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "trufflesecurity/trufflehog",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
