#!/usr/bin/env bash
#MISE description="Dep CVE check via safety (free no-login mode pins v2.x; SAFETY_API_KEY enables v3 scan)"
#MISE hide=true
#MISE raw=true

set -euo pipefail

# safety v3+ requires login for `safety scan`. Without API key, pin to v2.x to keep
# free no-login DB (note: v2 DB is older than upstream — use as compl to pip-audit).
if [ -n "${SAFETY_API_KEY:-}" ]; then
  uvx safety scan --output text
else
  # safety v2 `check` defaults to scanning the env it runs in — the uvx ephemeral
  # env, not the project venv. Feed the project deps via --stdin instead, so the
  # tool's own pinned setuptools<81 (kept for pkg_resources) is not scanned
  # (the DB flags setuptools<83, e.g. CVE-2026-59890 — a catch-22 otherwise).
  uv pip freeze | uvx --with 'setuptools<81' 'safety<3' check --stdin --output text
fi
