#!/usr/bin/env bash
#MISE description="Type check Python via ty (Astral's Rust-based type checker, Beta)"
#MISE hide=true
#MISE raw=true
#USAGE flag "--pyrefly" help="Use Meta's pyrefly instead of Astral's ty"

set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/py-env"

# shellcheck disable=SC2154
if [ "${usage_pyrefly:-false}" = "true" ]; then
  # Pyrefly resolves scope from project-includes/project-excludes in
  # pyproject.toml; passing paths on the CLI bypasses project-excludes.
  uvx pyrefly check
else
  uvx ty check "$PY_LINT_PATHS"
fi
