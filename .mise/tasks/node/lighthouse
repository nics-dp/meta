#!/usr/bin/env bash
#MISE description="Run Lighthouse CI on built dist/ (repo-local lighthouserc wins; else meta default)"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="1.3.14"}
#MISE depends=["node:build"]

set -euo pipefail

# Prefer a repo-local Lighthouse config when one is present: use it verbatim
# and never fetch or overwrite anything. This lets a repo pin app-specific
# thresholds/budgets (e.g. error-level CWV, byte budgets) while repos without
# one fall back to the shared meta default below. Also avoids the network
# dependency on the meta CDN when a repo ships its own config.
# Detection is by file PRESENCE (not git-tracked status): a normal checkout
# only carries the committed config, though a leftover fallback file from a
# hard-killed prior run would also be treated as repo-local until removed.
# Filenames match what lhci auto-detects (json/js/cjs/yml/yaml, with/without dot).
repo_config=""
for c in \
  lighthouserc.js lighthouserc.cjs lighthouserc.json lighthouserc.yml lighthouserc.yaml \
  .lighthouserc.js .lighthouserc.cjs .lighthouserc.json .lighthouserc.yml .lighthouserc.yaml; do
  if [ -f "$c" ]; then
    repo_config="$c"
    break
  fi
done

if [ -n "$repo_config" ]; then
  echo "Using repo-local $repo_config (skipping shared meta default)"
  bunx --bun @lhci/cli autorun
  exit 0
fi

# No repo config: fetch the shared meta default into the repo root, run, and
# attempt to clean it up on exit (best-effort — a hard kill such as SIGKILL
# bypasses the trap and can still leave the file behind).
#
# meta/configs ships the default in both JSON and YAML. A repo with no
# committed config may pick which one to fetch via META_LIGHTHOUSE_DEFAULT
# (basename only); defaults to lighthouserc.json for backward compatibility.
# We fetch to that same filename at the repo root so lhci auto-detects it, and
# the cleanup removes exactly what we fetched.
META_CONFIG_BASE="${META_CONFIG_BASE:-https://raw.githubusercontent.com/nics-dp/meta/main/configs}"
default_config="${META_LIGHTHOUSE_DEFAULT:-lighthouserc.json}"
# Only the formats meta actually ships in configs/ are valid here (this selects
# a meta-hosted default to fetch, not an arbitrary local filename). YAML users
# fetch lighthouserc.yml; lhci auto-detects .yml fine, so .yaml is not offered.
case "$default_config" in
  lighthouserc.json | lighthouserc.yml) ;;
  *)
    echo "Invalid META_LIGHTHOUSE_DEFAULT='$default_config' (expected lighthouserc.json|lighthouserc.yml)" >&2
    exit 1
    ;;
esac
cleanup() {
  rc=$?
  # Best-effort: never let an rm failure clobber the real exit code. Under
  # `set -e` a failing command inside the EXIT trap would abort before the
  # `exit "$rc"` below, overwriting the original status.
  rm -f "$default_config" || true
  exit "$rc"
}
trap cleanup EXIT
echo "No repo-local lighthouserc found; fetching shared meta default $default_config from $META_CONFIG_BASE"
curl -fsSL "$META_CONFIG_BASE/$default_config" -o "$default_config"
bunx --bun @lhci/cli autorun
