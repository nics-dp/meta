#!/usr/bin/env bash
#MISE description="Run Lighthouse CI on built dist/"
#MISE hide=true
#MISE raw=true
#MISE depends=["node:build"]
#MISE tools={bun="latest"}

META_CONFIG_BASE="${META_CONFIG_BASE:-https://raw.githubusercontent.com/nics-dp/meta/main/configs}"
cleanup() {
  rc=$?
  rm -f lighthouserc.json
  exit "$rc"
}
trap cleanup EXIT
curl -fsSL "$META_CONFIG_BASE/lighthouserc.json" -o lighthouserc.json

bunx --bun @lhci/cli autorun
