#!/usr/bin/env bash
#MISE description="Format JS/TS with prettier"
#MISE hide=true
#MISE raw=true

META_CONFIG_BASE="${META_CONFIG_BASE:-https://raw.githubusercontent.com/nics-dp/meta/main/configs}"
cleanup() {
  rc=$?
  rm -f .prettierrc.json .prettierignore
  exit "$rc"
}
trap cleanup EXIT
curl -fsSL "$META_CONFIG_BASE/.prettierrc.json" -o .prettierrc.json
curl -fsSL "$META_CONFIG_BASE/.prettierignore" -o .prettierignore

bunx prettier --write .

if ! git diff --exit-code -- . >/dev/null; then
  echo ""
  echo "⚠ Formatting changes detected. Please commit the result."
  git diff --stat -- .
fi
