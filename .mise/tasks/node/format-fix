#!/usr/bin/env bash
#MISE description="Format JS/TS with prettier"
#MISE hide=true
#MISE raw=true
#MISE silent="stdout"
#MISE tools={bun="1.4.0"}
#MISE depends=["node:install"]

set -euo pipefail

# Repo-local configs win; else fetched with retry + fail-loud (see lib/fetch-config).
source "$(dirname "$0")/../lib/fetch-config"
fetch_config .prettierrc.json .prettierignore

bunx prettier --write .

if ! git diff --exit-code -- . >/dev/null; then
  echo ""
  echo "⚠ Formatting changes detected. Please commit the result."
  git diff --stat -- .
fi
