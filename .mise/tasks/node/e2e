#!/usr/bin/env bash
#MISE description="Run E2E tests via Playwright"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="1.3.14"}
#MISE depends=["node:install", "node:e2e-install"]

# Repo-local playwright.config.ts wins; else fetched with retry + fail-loud (see lib/fetch-config).
