#!/usr/bin/env bash
#MISE description="Show JS/TS dep tree via bun pm ls / bun why"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="1.3.14"}
#USAGE arg "[package]" help="Filter to substring (or use --why for reverse query)"
#USAGE flag "--why" help="Show why <package> is installed (uses 'bun why')"
#USAGE flag "--all" help="Include transitive deps (default: direct only)"

# shellcheck disable=SC2154
set -euo pipefail

if [ "${usage_why:-false}" = "true" ]; then
  if [ -z "${usage_package:-}" ]; then
    echo "Error: --why requires <package> argument" >&2
    exit 1
  fi
  bun why "$usage_package"
  exit 0
fi

cmd=(bun pm ls)
[ "${usage_all:-false}" = "true" ] && cmd+=(--all)

if [ -n "${usage_package:-}" ]; then
  "${cmd[@]}" | grep -- "$usage_package" || {
    echo "No deps match '$usage_package'" >&2
    exit 1
  }
else
  "${cmd[@]}"
fi
