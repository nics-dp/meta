#!/usr/bin/env bash
#MISE description="Mutation testing (mutator) for the TypeScript/JavaScript files a pull request adds or modifies; fails on any surviving mutant"
#MISE hide=true
#MISE raw=true
#MISE depends=["node:install"]
#MISE tools={bun="1.4.3","aqua:astral-sh/uv"="0.13.1"}
#USAGE arg "[files]" var=#true var_min=0 help="Source files to mutate (default: the pull request's added or modified files)"

# Each mutant is judged by the vitest tests whose import graph reaches its
# file (lib/quality-tools quality_node_test_command), with coverage from
# node:test's vitest run so uncovered lines are reported, not mutated. A
# surviving mutant (mutator exit 3) or a failing baseline (exit 2) fails the
# atom. Outside a pull request, with no files named, there is nothing to
# mutate: a whole-package run is too slow for CI and is run by hand. crapper,
# which names the functions, does not parse .vue files, so they are not
# mutated.

set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/quality-tools"

files=()
# shellcheck disable=SC2154
if [ -n "${usage_files:-}" ]; then
  # shellcheck disable=SC2206
  files=($usage_files)
else
  base=$(quality_base_ref) || exit 2
  if [ -z "$base" ]; then
    echo "node:mutate: not a pull request and no files given; nothing to mutate"
    exit 0
  fi
  list=$(quality_node_sources "$base") || { echo "node:mutate: could not list sources changed since $base" >&2; exit 2; }
  while IFS= read -r f; do
    [ -n "$f" ] && files+=("$f")
  done <<< "$list"
fi

if [ "${#files[@]}" -eq 0 ]; then
  echo "node:mutate: no TypeScript/JavaScript source files to mutate"
  exit 0
fi

report=$(mktemp)
trap 'rm -f "$report"; quality_restore; quality_unlock' EXIT
quality_lock
quality_lcov_aside
quality_node_coverage

for f in "${files[@]}"; do
  quality_mutate_file "$f" "$(quality_node_test_command "$f")" "$report"
done

quality_summary "Mutation testing" "$report"
quality_mutate_exit node:mutate
