#!/usr/bin/env bash
#MISE description="Detect unused JS/TS deps and exports (knip)"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="latest"}
#MISE depends=["node:install"]

# knip config is repo-specific (entries / ignores differ per project), so it is
# NOT shared from meta: each consumer commits its own knip.json at the repo root
# and knip auto-discovers it. No META_CONFIG_BASE fetch here.

# Guard: fail loudly if the repo-local knip config is missing, instead of
# silently falling back to knip's zero-config inference (different ignores/entries).
have_cfg=0
for f in knip.json knip.jsonc .knip.json knip.ts knip.js knip.config.ts knip.config.js; do
  if [ -f "$f" ]; then have_cfg=1; break; fi
done
if [ "$have_cfg" -eq 0 ] && ! grep -qs '"knip"' package.json; then
  echo "node:knip: no knip config found at the repo root (knip.json/.jsonc/.ts/.js or package.json#knip). knip config is repo-local — commit one." >&2
  exit 1
fi

bunx knip
