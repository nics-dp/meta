#!/usr/bin/env bash
#MISE description="Lint JS/TS with autofix"
#MISE hide=true
#MISE raw=true
#MISE silent="stdout"
#MISE tools={bun="latest"}
#MISE depends=["node:install"]

META_CONFIG_BASE="${META_CONFIG_BASE:-https://raw.githubusercontent.com/nics-dp/meta/main/configs}"
cleanup() {
  rc=$?
  rm -f eslint.config.js
  exit "$rc"
}
trap cleanup EXIT
curl -fsSL "$META_CONFIG_BASE/eslint.config.js" -o eslint.config.js

# Warn if eslint plugins required by shared config are missing.
REQUIRED_PLUGINS=(
  eslint-plugin-vue
  eslint-plugin-security
  '@vue/eslint-config-typescript'
)
missing=()
for pkg in "${REQUIRED_PLUGINS[@]}"; do
  if [ ! -d "node_modules/$pkg" ] && ! grep -q "\"$pkg\"" package.json 2>/dev/null; then
    missing+=("$pkg")
  fi
done
if [ ${#missing[@]} -gt 0 ]; then
  echo ""
  echo "⚠ Missing eslint plugins (required by shared config):"
  for p in "${missing[@]}"; do echo "  - $p"; done
  echo ""
  echo "  Install:"
  echo "      bun add -D ${missing[*]}"
  echo ""
fi

bunx eslint --fix .

if ! git diff --exit-code -- . >/dev/null; then
  echo ""
  echo "⚠ Lint autofix changes detected. Please commit the result."
  git diff --stat -- .
fi
