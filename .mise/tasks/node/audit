#!/usr/bin/env bash
#MISE description="Audit JS/TS deps; gate only advisories with a published fix"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="1.4.2"}
set -euo pipefail

# An advisory with no published fixed version is not actionable, so it is reported
# as a warning and ignored; it gates again on its own once upstream publishes a fix.
# Only the `no published version fixes:` section of the dry run is read: a fix blocked
# by a dependent's range is listed elsewhere and still gates. If the section cannot be
# read (format change, network error), nothing is ignored and the full audit gates.
unfixable=$(bun audit fix --latest --dry-run 2>&1 \
  | awk '/^no published version fixes:/{f=1;next} f&&/^[^ ]/{f=0} f' \
  | grep -oE 'GHSA(-[0-9a-z]{4}){3}' | sort -u || true)

args=()
for id in $unfixable; do
  echo "::warning::no published fix for $id, not gating"
  args+=(--ignore="$id")
done
bun audit "${args[@]}"
