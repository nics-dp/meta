#!/usr/bin/env bash
#MISE description="Check JS/TS formatting (oxfmt; native binary, no Node)"
#MISE hide=true
#MISE raw=true
#MISE tools={bun="1.3.14"}
#MISE depends=["node:install"]

# oxfmt (OXC) — native single-binary formatter, run through bun so no Node
# runtime is needed. Parallel/opt-in replacement for the prettier-based
# node:format-check (prettier atom stays). Config fetched from meta configs/;
# its built-in sortTailwindcss subsumes prettier-plugin-tailwindcss.
# No pinned version: bunx resolves oxfmt from the consumer's node_modules, so
# the version is controlled by each repo's package.json devDeps (renovate-bumped,
# knip-ignored) — avoids @latest drift across repos on beta oxfmt.

# Repo-local .oxfmtrc.json wins; else fetched with retry + fail-loud (see lib/fetch-config).
source "$(dirname "$0")/../lib/fetch-config"
fetch_config .oxfmtrc.json

# Warn if oxfmt is missing (bunx would otherwise fetch @latest, risking drift).
if [ ! -d "node_modules/oxfmt" ] && ! grep -q '"oxfmt"' package.json 2>/dev/null; then
  echo ""
  echo "⚠ oxfmt not found in package.json — bunx will fall back to @latest."
  echo "  Pin it so the version is reproducible and renovate-managed:"
  echo "      bun add -D oxfmt"
  echo ""
fi

bunx --bun oxfmt --check .
