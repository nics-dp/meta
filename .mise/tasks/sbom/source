#!/usr/bin/env bash
#MISE description="Generate CycloneDX SBOM for source"
#MISE hide=true
#MISE tools={"aqua:anchore/syft"="1.51.1"}

# Pin the spec version: syft defaults cyclonedx-json to 1.7, and sbom:enrich's parlay
# decodes up to 1.6 (snyk/parlay#136).
syft scan . -o cyclonedx-json@1.6=sbom-source.cdx.json
