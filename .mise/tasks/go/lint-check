#!/usr/bin/env bash
#MISE description="Lint Go (read-only): formatter drift + linters"
#MISE hide=true
#MISE raw=true
#MISE depends=["go:install"]
#MISE tools={"aqua:golangci/golangci-lint"="2.13.2"}

set -uo pipefail

# `run` checks configured formatters within its `run.tests` scope.
# `fmt --diff` also checks excluded test files, falls back to gofmt when no
# formatters are configured, and fails on drift without rewriting files.
# Widening formatter coverage is a per-repo config change.
# The local `go:lint-fix` only warns.
#
# Both stages run before the exit code is decided, deliberately not fail-fast,
# so a PR carrying both kinds of problem sees both in one CI round.
rc=0
golangci-lint fmt --diff ./... || rc=1
golangci-lint run ./... || rc=1
exit "$rc"
