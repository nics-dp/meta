#!/usr/bin/env bash
#MISE description="Lint Go with autofix (golangci-lint fmt)"
#MISE hide=true
#MISE raw=true
#MISE silent="stdout"
#MISE tools={"aqua:golangci/golangci-lint"="2.13.2"}

golangci-lint fmt ./...

if ! git diff --exit-code -- . >/dev/null; then
  echo ""
  echo "⚠ Formatting changes detected after 'golangci-lint fmt ./...'. Please commit the result."
  git diff --stat -- .
fi
