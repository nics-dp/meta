#!/usr/bin/env bash
#MISE description="Mutation testing (mutator) for the Go files a pull request adds or modifies; fails on any surviving mutant"
#MISE hide=true
#MISE raw=true
#MISE depends=["go:install"]
#MISE tools={"aqua:astral-sh/uv"="0.13.1"}
#USAGE arg "[files]" var=#true var_min=0 help="Go source files to mutate (default: the pull request's added or modified files)"

# Each mutant is judged by the tests of its own package plus the mirrored
# package under test/ (lib/quality-tools quality_go_test_command), with
# coverage from go:test's run so uncovered lines are reported, not mutated.
# A surviving mutant (mutator exit 3) or a failing baseline (exit 2) fails the
# atom. Outside a pull request, with no files named, there is nothing to
# mutate: a whole-module run is too slow for CI and is run by hand.

set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/go-env"
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/quality-tools"

# mutator runs each mutant in a worker directory under target/mutation-workers.
# An active go.work lists the module's real directory, not the worker's, so
# every worker build fails, and mutator counts any failing test run as a
# killed mutant: under a workspace the atom would pass without testing one.
gowork=$(go env GOWORK)
if [ -n "$gowork" ] && [ "$gowork" != "off" ]; then
  echo "go:mutate: a Go workspace is active ($gowork); run with GOWORK=off" >&2
  exit 2
fi

files=()
# shellcheck disable=SC2154
if [ -n "${usage_files:-}" ]; then
  # shellcheck disable=SC2206
  files=($usage_files)
else
  base=$(quality_base_ref) || exit 2
  if [ -z "$base" ]; then
    echo "go:mutate: not a pull request and no files given; nothing to mutate"
    exit 0
  fi
  list=$(quality_go_sources "$base") || { echo "go:mutate: could not list Go sources changed since $base" >&2; exit 2; }
  while IFS= read -r f; do
    [ -n "$f" ] && files+=("$f")
  done <<< "$list"
fi

if [ "${#files[@]}" -eq 0 ]; then
  echo "go:mutate: no Go source files to mutate"
  exit 0
fi

report=$(mktemp)
trap 'rm -f "$report"; quality_go_profiles_restore; quality_unlock' EXIT
quality_lock
quality_go_profiles_aside
quality_go_coverage

worst=0
skipped=0
for f in "${files[@]}"; do
  # mutator links a package's non-Go files into each worker as symlinks, and
  # //go:embed refuses a symlink ("cannot embed irregular file"), so every
  # worker build of such a package fails and mutator would count each mutant
  # as killed. Those files are reported as not mutated instead of passing.
  if grep -qs '^//go:embed' "$(dirname "$f")"/*.go; then
    echo "==> $f: SKIPPED (package uses //go:embed; mutator workers cannot build it)"
    echo "== $f SKIPPED: package uses //go:embed, which mutator's symlinked workers cannot build" >> "$report"
    skipped=$((skipped + 1))
    continue
  fi
  cmd=$(quality_go_test_command "$f")
  echo "==> $f ($cmd)"
  code=0
  # --mutate-all: mutator otherwise keeps a killed result for a function whose
  # text has not changed, which stays killed even after its tests are weakened.
  quality_mutator --mutate-all --use-existing-coverage --test-command "$cmd" "$f" > "$report.one" 2>&1 || code=$?
  cat "$report.one"
  {
    echo "== $f (exit $code)"
    grep -E '^(SURVIVED|Total)' "$report.one" || true
  } >> "$report"
  rm -f "$report.one"
  [ "$code" -gt "$worst" ] && worst=$code
done

quality_summary "Mutation testing" "$report"
[ "$skipped" -gt 0 ] && echo "go:mutate: $skipped file(s) not mutated (go:embed packages); see the summary" >&2
case "$worst" in
  0) exit 0 ;;
  3) echo "go:mutate: surviving mutants (see SURVIVED lines)" >&2; exit 1 ;;
  2) echo "go:mutate: baseline tests failed before any mutant ran" >&2; exit 1 ;;
  *) echo "go:mutate: mutator exited $worst" >&2; exit 1 ;;
esac
