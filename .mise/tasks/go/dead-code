#!/usr/bin/env bash
#MISE description="Find unreachable functions via whole-program analysis (golang.org/x/tools/cmd/deadcode)"
#MISE hide=true
#MISE raw=true
#MISE tools={"go:golang.org/x/tools/cmd/deadcode"="latest"}
#USAGE arg "[entry]" help="Entry package(s) (default: ./... — analyzes every cmd/* main)"
#USAGE flag "--filter <regex>" help="Only report functions matching regex"
#USAGE flag "--whole-program" help="Run analysis even on test code"

# shellcheck disable=SC2154
set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/go-env"

entry="${usage_entry:-./...}"
cmd=(deadcode)
[ -n "${usage_filter:-}" ] && cmd+=(-filter "$usage_filter")
[ "${usage_whole_program:-false}" = "true" ] && cmd+=(-test)
[ -n "$GO_TEST_TAGS" ] && cmd+=(-tags "$GO_TEST_TAGS")
cmd+=("$entry")

"${cmd[@]}"
