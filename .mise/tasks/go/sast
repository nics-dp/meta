#!/usr/bin/env bash
#MISE description="Run gosec security scanner"
#MISE hide=true
#MISE raw=true
#MISE depends=["go:install"]
#MISE tools={"github:securego/gosec"="v2.30.0"}

# The gosec release binary type-checks with the go/types of the Go its release was built with: on a
# module whose go.mod declares a newer Go language version, every package reports an error until a
# gosec release built with that Go ships. security-sarif.yml installs the same release, and its pin
# moves together with this one.
# -terse, not -quiet: with no findings, -quiet exits 0 before gosec counts package load errors, so
# -terse is what makes those errors fail this task.

gosec -terse ./...
