#!/usr/bin/env bash
#MISE description="Migrate Go source to new APIs via go fix over the production build and the GO_TEST_TAGS build"
#MISE hide=true
#MISE raw=true
#MISE depends=["go:install"]
#MISE silent="stdout"

set -euo pipefail
# shellcheck disable=SC1091
source "$(dirname "$0")/../lib/go-env"

# The untagged pass is the production build and keeps the production constraints, so a file the
# tagged build excludes (`//go:build !test` under the default tags) is still fixed. The GO_TEST_TAGS
# pass (default `test`, the tags go:test compiles with) extends coverage to the files gated on those
# tags, such as test files and test-only seams.
go fix ./...
go fix "-tags=$GO_TEST_TAGS" ./...

if ! git diff --exit-code -- . >/dev/null; then
  echo ""
  echo "⚠ Source changes from 'go fix'. Please review and commit."
  git diff --stat -- .
fi
