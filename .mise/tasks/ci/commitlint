#!/usr/bin/env bash
#MISE description="Run commitlint on recent commits"
#MISE raw=true

META_CONFIG_BASE="${META_CONFIG_BASE:-https://raw.githubusercontent.com/nics-dp/meta/main/configs}"
trap 'rc=$?; rm -f .commitlintrc.yml; exit $rc' EXIT
curl -fsSL "$META_CONFIG_BASE/.commitlintrc.yml" -o .commitlintrc.yml

bun install --no-save @commitlint/cli @commitlint/config-conventional && bunx commitlint --from HEAD~1 --to HEAD
