#!/usr/bin/env bash
#MISE description="Scan for leaked secrets (betterleaks; PR gate)"
#MISE hide=true
#MISE raw=true
# Requires mise >= 2026.7.0. Installing this tool verifies its GitHub artifact
# attestation; GitHub rotated its TSA cert on 2026-06-12 and older mise builds
# ship a stale embedded Sigstore trust root, failing every post-rotation
# attestation with "TSA timestamp verification failed: no certificate matches
# issuer and serial number" (jdx/mise#10680 — the artifact itself is fine; an
# earlier note here wrongly blamed betterleaks 1.6.0 for it). The version pin
# below is Renovate-managed and safe to bump normally.
#MISE tools={"github:betterleaks/betterleaks"="1.8.1"}
set -euo pipefail

# betterleaks: fast, configurable secret scanner from the Gitleaks authors. Used
# as the PR gate -- its default `--exit-code 1` on findings makes the caller's
# mise-task.yml "Enforce" step fail CI. --redact keeps secret values out of the
# CI logs; --no-banner trims noise from the job summary.
#
# On a pull_request we preferentially scan only the commits the PR introduces
# (base..HEAD) so a pre-existing historical leak does not block every unrelated
# PR; if the base ref can't be fetched we fall back to a full-history scan (see
# the fetch guard below). On push / workflow_dispatch we scan the full history.
# Both require the caller to checkout with fetch-depth: 0 for the full commit
# history; the PR base ref itself is pulled in by the git fetch below (checkout
# alone fetches only the checked-out ref, even at fetch-depth: 0).
#
# Org-wide allowlist: extend the default rule set and only *subtract* well
# understood false positives. Two path rules cover vendored third-party code and
# test fixtures (Go test/mock/testdata; vitest .test/.spec and __tests__).
# Everything else is subtracted by *anchored secret-value* regexes, not by
# path, so an entry can only ever silence the one literal it names -- but it
# silences that literal org-wide, in any path; keep each entry backed by
# findings that the path rules do not already cover, and delete it once they
# do. The categories: known
# local-dev placeholder credentials (dev-stack compose/mise/deploy defaults),
# code identifiers the generic rules mistake for values, and pure zh-TW UI
# copy. Three narrow exceptions remain -- one historical dcf-platform
# seed-default admin password, scoped with condition = "AND" to the two
# commits that introduced it (outside git history that condition fails closed
# and the finding resurfaces); the user:pass@host doc-example URI in the CLI
# clients, scoped with condition = "AND" to pkg/api/client.go; and the
# GHAS-dismissed dev-only placeholder token in dcf-platform-cli.
#
# The config is written to a temp file and passed via --config; it cannot sit as
# a sibling .toml under .mise/tasks/ because mise would mis-parse it as a task
# definition. Keep every entry narrow -- never allowlist a path that holds real
# application secrets. Keep the regexes free of tera delimiters ({{, {%, {#):
# this file is a task script, so mise never templates the heredoc body and they
# are inert here today, but the same text in a mise-templated context would be
# rendered rather than matched.
#
# See nics-dp/meta#347 for why the 1.8.1 generic-password and
# generic-credential-uri rules required this expansion (2026-08-25).
config="$(mktemp)"
trap 'rm -f "$config"' EXIT
cat > "$config" <<'BLCFG'
[extend]
useDefault = true

[[allowlists]]
description = "Vendored deps and Go test/mock fixtures"
paths = [
  '''(^|/)vendor/''',
  '''_test\.go$''',
  '''(^|/)mocks?/''',
  '''(^|/)testdata/''',
]

[[allowlists]]
description = "Frontend unit-test fixtures (vitest)"
paths = [
  '''\.(test|spec)\.[cm]?[jt]sx?$''',
  '''(^|/)__tests__/''',
]

[[allowlists]]
description = "dcf-platform-cli dev-only defaultAccessToken (GHAS-dismissed)"
regexTarget = "match"
regexes = [ '''ds-RVNFZVlGT2hhZlNtT2JOVg''' ]

[[allowlists]]
description = "dcf-platform 2026-03 seed-default admin password, removed since; scoped to the two introducing commits. condition=AND is load-bearing: outside git history (dir mode, rewritten SHAs) it fails closed and the finding resurfaces"
condition = "AND"
commits = [
  "ead693679cdfc45d62ed79c170f48c093fd6d269",
  "2d25cce034f2624c50ce2560b2f5dbac416bd4e5",
]
regexTarget = "secret"
regexes = [ '''^adminPass@nics\.dcf$''' ]

[[allowlists]]
description = "user:pass@host doc-example URI in the CLI clients (access-cli, platform-cli). condition=AND: the value is only allowlisted inside pkg/api/client.go"
condition = "AND"
paths = [ '''(^|/)pkg/api/client\.go$''' ]
regexTarget = "secret"
regexes = [ '''^pass$''' ]

[[allowlists]]
description = "Known local-dev placeholder credentials (compose/mise/deploy dev-stack defaults). Anchored value filters with no path predicate: each silences its literal org-wide -- consciously accepted (a real stg/prod password equal to one of these is a password-policy problem, not a detection gap). Compensating control: ci:trufflehog's full-history --results=verified sweep does not consume this config, though it only catches live-verifiable credentials"
regexTarget = "secret"
regexes = [
  '''^password123$''',
  '''^postgres123$''',
  '''^app_pass_123$''',
  '''^-app_pass_123\}$''',
  '''^rep_pass_123$''',
  '''^dcf_secure_password$''',
  '''^AdminPass1234$''',
  '''^StrongPass123!$''',
  '''^test-admin-password$''',
  '''^CHANGE_ME$''',
  '''^(new|old)-pass$''',
]

[[allowlists]]
description = "Identifier and zh-TW UI-copy false positives (the CJK entry matches pure display copy only; any ASCII letter in the value defeats it)"
regexTarget = "secret"
regexes = [
  '''^(wrong|newPassword|adminPassword|change_password|reset_password)$''',
  '''^(openResetPasswordDialog|resetConfirmPassword|resetNewPassword|submitResetPassword)$''',
  '''^(newPassword|password)\.value$''',
  '''^d\.cfg\.DCFUserAdminPassword$''',
  '''^dcf_app_password$''',
  '''^[\s\d，、。：；（）「」]*\p{Han}[\p{Han}\s\d，、。：；（）「」]*$''',
]
BLCFG
common=(git . --redact --no-banner --config "$config")

if [ "${GITHUB_EVENT_NAME:-}" = "pull_request" ] && [ -n "${GITHUB_BASE_REF:-}" ]; then
  # Bring the PR's base branch into the local graph so base..HEAD resolves
  # (actions/checkout fetches only the checked-out ref, even at fetch-depth: 0).
  # On fetch failure (missing ref / permissions) fall back to a full-history
  # scan: running a range scan against an absent base ref would fail for a
  # reason unrelated to any leak. Merge commits are intentionally NOT excluded
  # so secrets introduced while resolving a conflict are still caught.
  if git fetch --no-tags --quiet origin \
      "+refs/heads/${GITHUB_BASE_REF}:refs/remotes/origin/${GITHUB_BASE_REF}"; then
    betterleaks "${common[@]}" --log-opts="origin/${GITHUB_BASE_REF}..HEAD"
  else
    echo "::warning::could not fetch base ref '${GITHUB_BASE_REF}'; scanning full history instead"
    betterleaks "${common[@]}"
  fi
else
  betterleaks "${common[@]}"
fi
