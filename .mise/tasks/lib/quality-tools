#!/usr/bin/env bash
# Sourced helper for the CRAP and mutation atoms (go:, py:, node: crap and
# mutate). Runs crapper and mutator at pinned commits through uvx, so no
# checkout, venv or pip is left in the consumer repository. Neither project
# publishes releases, so the pins are commit SHAs; the "unclebob quality tools"
# custom manager in renovate.json moves them. mutator imports crapper for
# function names, so its environment carries crapper at the same pin.
#
# Callers declare uv in their own `#MISE tools=` header.

QUALITY_CRAPPER_REF="c757ec79a6c15dc815238bbd9c2f4601eb54d3cc" # renovate: https://github.com/unclebob/crapper branch=master
QUALITY_MUTATOR_REF="0136cf555797f1c9552388c40207eb2f13af9535" # renovate: https://github.com/unclebob/mutator branch=main
QUALITY_PYTHON="3.13"

quality_crapper() {
  uvx --quiet --python "$QUALITY_PYTHON" \
    --from "git+https://github.com/unclebob/crapper@${QUALITY_CRAPPER_REF}" \
    crapper "$@"
}

quality_mutator() {
  uvx --quiet --python "$QUALITY_PYTHON" \
    --with "git+https://github.com/unclebob/crapper@${QUALITY_CRAPPER_REF}" \
    --from "git+https://github.com/unclebob/mutator@${QUALITY_MUTATOR_REF}" \
    mutator "$@"
}

# quality_base_ref: the ref a pull request is compared against. Prints
# origin/<base> on a pull_request event and nothing outside one. A pull
# request whose checkout lacks that ref is an error, not "not a pull request":
# treating it as the latter would turn the changed-file gates into a
# whole-module scan or a silent skip. The caller's checkout must use
# fetch-depth: 0 (as ci:betterleaks does): mise-task.yml checks out with
# persist-credentials: false, so a fetch from inside the atom fails on a
# private repository.
quality_base_ref() {
  [ "${GITHUB_EVENT_NAME:-}" = "pull_request" ] || return 0
  if [ -z "${GITHUB_BASE_REF:-}" ] \
     || ! git rev-parse --verify --quiet "origin/${GITHUB_BASE_REF}^{commit}" >/dev/null; then
    echo "quality: pull request without origin/${GITHUB_BASE_REF:-<base>} in the checkout; check out with fetch-depth: 0" >&2
    return 1
  fi
  printf 'origin/%s\n' "$GITHUB_BASE_REF"
}

# quality_files <base-ref|""> <pathspec>...: files matching the pathspecs, one
# per line, relative to the current directory (the module root, which may be a
# subdirectory of the repository). With a base ref, only files added or
# modified since the merge base; without, every tracked file. A failing git
# command fails the function, so a caller that captures the list with $(...)
# can tell "nothing changed" from "could not tell".
quality_files() {
  local base=$1
  shift
  if [ -n "$base" ]; then
    # --no-renames: a renamed and edited file would otherwise be status R and
    # fall outside --diff-filter=AM; split, its new path is an addition.
    # core.quotePath=false: git otherwise prints a non-ASCII path quoted with
    # octal escapes, which is not a file name either tool can open.
    git -c core.quotePath=false diff --relative --no-renames --name-only --diff-filter=AM "$base...HEAD" -- "$@"
  else
    git -c core.quotePath=false ls-files -- "$@"
  fi
}

# quality_go_sources / quality_py_sources / quality_node_sources [<base-ref>]:
# the source files crapper and mutator score for one language (quality_files
# filtered). Tests, test trees, vendored or installed dependencies and build
# configuration are not scored: they are what exercises the code, not the code
# at risk. crapper does not parse Vue single-file components, so node takes
# .ts/.tsx/.js family files only.
quality_go_sources() {
  local files
  files=$(quality_files "${1:-}" '*.go') || return 1
  printf '%s\n' "$files" | awk 'NF && !/_test\.go$/ && !/(^|\/)vendor\// && !/^test\// && !/(^|\/)testdata\//'
}
quality_py_sources() {
  local files
  files=$(quality_files "${1:-}" '*.py') || return 1
  printf '%s\n' "$files" | awk 'NF && !/(^|\/)(tests?|\.?venv)\// && !/(^|\/)(test_[^\/]*|[^\/]*_test|conftest)\.py$/'
}
quality_node_sources() {
  local files
  files=$(quality_files "${1:-}" '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.mts' '*.cts') || return 1
  printf '%s\n' "$files" | awk 'NF && !/(^|\/)(node_modules|dist|__tests__|tests?)\// && !/\.(test|spec)\.[cm]?[jt]sx?$/ && !/\.d\.[cm]?ts$/ && !/(^|\/)[^\/]*\.config\.[cm]?[jt]s$/'
}

# quality_aside <file>... / quality_restore: crapper merges every report it
# finds at fixed paths (Go profiles at the module root and under
# target/coverage; LCOV under target/coverage/ and coverage/, a later file
# winning for the same source), so a report left by an earlier go:test or
# vitest run would be read next to the fresh one and skew the scores. The atoms
# move those files aside for the run and put them back afterwards. A symbolic
# link is moved and restored as the link itself, dangling or not.
QUALITY_ASIDE_DIR=""
quality_aside() {
  local f
  QUALITY_ASIDE_DIR=$(mktemp -d)
  for f in "$@"; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    mkdir -p "$QUALITY_ASIDE_DIR/$(dirname "$f")"
    mv "$f" "$QUALITY_ASIDE_DIR/$f"
  done
}
quality_restore() {
  local f
  [ -n "$QUALITY_ASIDE_DIR" ] || return 0
  while IFS= read -r f; do
    f=${f#./}
    mkdir -p "$(dirname "$f")"
    mv "$QUALITY_ASIDE_DIR/$f" "$f"
  done < <(cd "$QUALITY_ASIDE_DIR" && find . ! -type d)
  rm -rf "$QUALITY_ASIDE_DIR"
  QUALITY_ASIDE_DIR=""
}
quality_go_profiles_aside() {
  quality_aside coverage.out target/coverage/coverage.out
}
# quality_lcov_aside: every LCOV report crapper would read besides the one
# the atom writes (target/coverage/<language>/lcov.info is rewritten).
quality_lcov_aside() {
  local f files=()
  while IFS= read -r f; do
    [ -n "$f" ] && files+=("$f")
  done < <(find target/coverage coverage -name lcov.info -type f 2>/dev/null)
  quality_aside ${files[@]+"${files[@]}"}
}

# quality_go_coverage: write the module's coverage profile where crapper and
# mutator read it (target/coverage/go/coverage.out). The test run is go:test's
# (GO_TEST_TAGS, GO_TEST_MOD, GO_COVERPKG, GO_TEST_PATHS from lib/go-env), so
# tests under test/ that cover internal packages through -coverpkg count. With
# -coverpkg every test package writes a row for every instrumented block, and
# crapper reads each row as a separate block, so the rows are folded into one
# per block with the counts summed before either tool reads the profile.
quality_go_coverage() {
  local out=target/coverage/go/coverage.out raw
  mkdir -p "$(dirname "$out")"
  raw="$out.raw"
  local cmd=(go test "-mod=$GO_TEST_MOD" -count=1 -covermode=atomic "-coverprofile=$raw")
  [ -n "${GO_TEST_TAGS:-}" ] && cmd+=("-tags=$GO_TEST_TAGS")
  [ -n "${GO_COVERPKG:-}" ] && cmd+=("-coverpkg=$GO_COVERPKG")
  cmd+=("$GO_TEST_PATHS")
  "${cmd[@]}"
  awk 'NR == 1 { print; next }
       { key = $1 " " $2
         if (!(key in count)) order[++n] = key
         count[key] += $3 }
       END { for (i = 1; i <= n; i++) print order[i], count[order[i]] }' "$raw" > "$out"
  rm -f "$raw"
}

# quality_py_coverage: run py:test's suite (PY_RUNNER, PY_TEST_PATHS from
# lib/py-env) under coverage.py and write target/coverage/python/lcov.info.
# coverage must be installed in the environment PY_RUNNER selects (the test
# dependency group by default); a missing one fails here instead of scoring
# every function as uncovered. A failing test fails the run, as in go:crap.
quality_py_coverage() {
  local dir=target/coverage/python
  if ! "${PY_RUNNER_ARR[@]}" python -c 'import coverage' >/dev/null 2>&1; then
    echo "quality: coverage is not importable through PY_RUNNER ($PY_RUNNER); add it to the test dependency group" >&2
    return 1
  fi
  mkdir -p "$dir"
  rm -f "$dir/.coverage" "$dir/lcov.info"
  "${PY_RUNNER_ARR[@]}" coverage run "--data-file=$dir/.coverage" -m pytest "$PY_TEST_PATHS"
  "${PY_RUNNER_ARR[@]}" coverage lcov "--data-file=$dir/.coverage" -o "$dir/lcov.info"
}

# quality_node_coverage: run node:test's vitest under coverage and write
# target/coverage/typescript/lcov.info, with the repository's own coverage
# include/exclude from its vitest config. The provider must be a devDependency;
# vitest would otherwise prompt to install it. reportOnFailure keeps the report
# when a test fails: coverage instrumentation slows async tests enough to trip
# their timeouts, the scores still hold, and Node Test is the gate for test
# results, so a failing run is a warning here.
quality_node_coverage() {
  local dir=target/coverage/typescript provider="" p status=0
  for p in coverage-v8 coverage-istanbul; do
    [ -d "node_modules/@vitest/$p" ] && provider=$p
  done
  if [ -z "$provider" ]; then
    echo "quality: no @vitest/coverage-v8 (or coverage-istanbul) in node_modules; add it as a devDependency at the vitest version" >&2
    return 1
  fi
  rm -rf "$dir"
  bunx vitest run --coverage --coverage.reporter=lcov "--coverage.reportsDirectory=$dir" --coverage.reportOnFailure=true || status=$?
  if [ ! -s "$dir/lcov.info" ]; then
    echo "quality: vitest wrote no $dir/lcov.info (exit $status)" >&2
    return 1
  fi
  [ "$status" -eq 0 ] || echo "quality: vitest exited $status; scoring the coverage it wrote (Node Test gates the test results)" >&2
  return 0
}

# quality_go_test_command <file>: the test command mutator runs for one Go
# source file -- its own package plus the mirrored package under test/ when
# that exists, else the whole GO_TEST_PATHS suite, so a mutant is never judged
# by a package that holds no test for it.
quality_go_test_command() {
  local dir targets=()
  dir=$(dirname "$1")
  ls "$dir"/*_test.go >/dev/null 2>&1 && targets+=("./$dir")
  [ -d "test/$dir" ] && targets+=("./test/$dir/...")
  [ "${#targets[@]}" -eq 0 ] && targets=("$GO_TEST_PATHS")
  # mutator hands this string to a shell, so every word is shell-quoted: a
  # space-separated GO_TEST_TAGS must stay one -tags argument.
  local test_cmd t
  test_cmd="go test $(printf '%q' "-mod=$GO_TEST_MOD") -count=1"
  [ -n "${GO_TEST_TAGS:-}" ] && test_cmd="$test_cmd $(printf '%q' "-tags=$GO_TEST_TAGS")"
  for t in "${targets[@]}"; do
    test_cmd="$test_cmd $(printf '%q' "$t")"
  done
  printf '%s\n' "$test_cmd"
}

# quality_py_interpreter: the absolute interpreter PY_RUNNER runs tests with.
# A mutator worker does not link .venv, so the mutant command names this path
# instead of going through PY_RUNNER, which would build a fresh environment in
# every worker; mutator puts the worker's sources first on PYTHONPATH.
quality_py_interpreter() {
  "${PY_RUNNER_ARR[@]}" python -c 'import sys; print(sys.executable)'
}

# quality_py_test_command <file> <interpreter>: the test command mutator runs
# for one Python source file -- the pytest test files (test_*.py, *_test.py)
# under PY_TEST_PATHS whose imports reach it, else the whole suite. Reach is
# the transitive closure of project imports read with the ast module (every
# import form, relative imports, a test directory's conftest.py), so a test
# that exercises the file through another module still judges its mutants; a
# test file that does not parse is kept. Only collected test files are named:
# a helper or benchmark module named on the command line would run even though
# pytest never collects it.
read -r -d '' QUALITY_PY_RELATED <<'PY' || true
import ast, os, sys

target = os.path.normpath(sys.argv[1])
test_paths = sys.argv[2]


def module_of(path):
    parts = os.path.normpath(path)[:-3].split(os.sep)
    if parts[0] == "src":
        parts = parts[1:]
    if parts and parts[-1] == "__init__":
        parts = parts[:-1]
    return parts


def file_of(name, here):
    rel = name.replace(".", os.sep)
    for base in ("", "src", here):
        for cand in (os.path.join(base, rel + ".py"), os.path.join(base, rel, "__init__.py")):
            if os.path.isfile(cand):
                return os.path.normpath(cand)
    return None


def reached(path, cache):
    if path in cache:
        return cache[path]
    try:
        with open(path, encoding="utf-8") as handle:
            tree = ast.parse(handle.read(), path)
    except (OSError, SyntaxError, ValueError):
        cache[path] = None
        return None
    here = os.path.dirname(path)
    package = module_of(path)
    if not path.endswith("__init__.py"):
        package = package[:-1]
    names = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            names += [alias.name for alias in node.names]
        elif isinstance(node, ast.ImportFrom):
            base = node.module or ""
            if node.level:
                parent = package[: len(package) - (node.level - 1)]
                base = ".".join(parent + ([node.module] if node.module else []))
            names.append(base)
            names += [(base + "." if base else "") + alias.name for alias in node.names]
    found = set()
    for name in names:
        parts = name.split(".")
        for i in range(1, len(parts) + 1):
            hit = file_of(".".join(parts[:i]), here)
            if hit:
                found.add(hit)
    cache[path] = found
    return found


def conftests(path):
    found, directory = [], os.path.dirname(path)
    while True:
        candidate = os.path.join(directory, "conftest.py")
        if os.path.isfile(candidate):
            found.append(os.path.normpath(candidate))
        if directory in ("", "."):
            return found
        directory = os.path.dirname(directory)


def tests():
    if os.path.isfile(test_paths):
        yield os.path.normpath(test_paths)
        return
    for directory, dirs, files in os.walk(test_paths):
        dirs[:] = sorted(d for d in dirs if d not in (".venv", "venv", "__pycache__", "node_modules"))
        for name in sorted(files):
            if name.endswith(".py") and (name.startswith("test_") or name.endswith("_test.py")):
                yield os.path.normpath(os.path.join(directory, name))


cache = {}
for test in tests():
    seen, todo = set(), [test] + conftests(test)
    hit = False
    while todo:
        path = todo.pop()
        if path in seen:
            continue
        seen.add(path)
        imports = reached(path, cache)
        if imports is None and path == test:
            hit = True
            break
        if path == target or (imports and target in imports):
            hit = True
            break
        todo.extend(imports or ())
    if hit:
        print(test)
PY
quality_py_test_command() {
  local t targets=()
  while IFS= read -r t; do
    [ -n "$t" ] && targets+=("$t")
  done < <("$2" -I -c "$QUALITY_PY_RELATED" "$1" "$PY_TEST_PATHS")
  [ "${#targets[@]}" -eq 0 ] && targets=("$PY_TEST_PATHS")
  local test_cmd
  test_cmd="$(printf '%q' "$2") -m pytest -q -p no:cacheprovider"
  for t in "${targets[@]}"; do
    test_cmd="$test_cmd $(printf '%q' "$t")"
  done
  printf '%s\n' "$test_cmd"
}

# quality_node_test_command <file>: the test command mutator runs for one
# TypeScript/JavaScript source file -- the vitest tests whose import graph
# reaches it. A file no test reaches has no covered site, so mutator runs no
# mutant for it; --passWithNoTests keeps its baseline from failing.
quality_node_test_command() {
  printf 'bunx vitest related --run --passWithNoTests %q\n' "$1"
}

# quality_crap_score <atom> <threshold> <scope> <file>...: score the files
# against the coverage already written, print the report and add it to the job
# summary. Returns crapper's status, or 0 for a threshold breach (status 2)
# under --report-only.
quality_crap_score() {
  local atom=$1 threshold=$2 scope=$3 report status=0
  shift 3
  report=$(mktemp)
  quality_crapper --use-existing-coverage --threshold "$threshold" "$@" > "$report" || status=$?
  cat "$report"
  quality_summary "CRAP (threshold $threshold$scope)" "$report"
  rm -f "$report"
  if [ "$status" -eq 2 ] && [ "${usage_report_only:-false}" = "true" ]; then
    echo "$atom: worst score above $threshold (report only)"
    return 0
  fi
  return "$status"
}

# quality_mutate_file <file> <test-command> <report>: run mutator on one file
# against the coverage already written, print its output and append the
# SURVIVED and Total lines to <report>. QUALITY_MUTATE_WORST keeps the highest
# exit status for quality_mutate_exit.
#
# --mutate-all: mutator otherwise keeps a killed result for a function whose
# text has not changed, which stays killed even after its tests are weakened.
QUALITY_MUTATE_WORST=0
quality_mutate_file() {
  local file=$1 test_cmd=$2 report=$3 one code=0
  one=$(mktemp)
  echo "==> $file ($test_cmd)"
  quality_mutator --mutate-all --use-existing-coverage --test-command "$test_cmd" "$file" > "$one" 2>&1 || code=$?
  cat "$one"
  {
    echo "== $file (exit $code)"
    grep -E '^(SURVIVED|Total)' "$one" || true
  } >> "$report"
  rm -f "$one"
  [ "$code" -gt "$QUALITY_MUTATE_WORST" ] && QUALITY_MUTATE_WORST=$code
  return 0
}

# quality_mutate_exit <atom>: the atom's exit status from QUALITY_MUTATE_WORST.
# A surviving mutant (mutator exit 3) or a failing baseline (exit 2) fails.
quality_mutate_exit() {
  case "$QUALITY_MUTATE_WORST" in
    0) return 0 ;;
    3) echo "$1: surviving mutants (see SURVIVED lines)" >&2 ;;
    2) echo "$1: baseline tests failed before any mutant ran" >&2 ;;
    *) echo "$1: mutator exited $QUALITY_MUTATE_WORST" >&2 ;;
  esac
  return 1
}

# quality_lock / quality_unlock: the crap and mutate atoms share the fixed
# paths crapper and mutator read (target/coverage/<language>/, the reports set
# aside), so two runs in one working tree serialize the whole
# aside-coverage-score-restore sequence. mkdir is the lock because macOS has no
# flock; a lock older than the timeout is reported, not broken.
QUALITY_LOCK_DIR=""
quality_lock() {
  local dir=target/coverage/.quality-lock waited=0
  mkdir -p target/coverage
  until mkdir "$dir" 2>/dev/null; do
    if [ "$waited" -ge 1800 ]; then
      echo "quality: $dir held for 30 minutes; remove it if no other run is active" >&2
      return 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  QUALITY_LOCK_DIR=$dir
}
quality_unlock() {
  [ -n "$QUALITY_LOCK_DIR" ] || return 0
  rmdir "$QUALITY_LOCK_DIR" 2>/dev/null || true
  QUALITY_LOCK_DIR=""
}

# quality_summary <title> <file>: append a fenced report to the job summary
# when running under GitHub Actions.
quality_summary() {
  [ -n "${GITHUB_STEP_SUMMARY:-}" ] || return 0
  {
    printf '### %s\n\n```text\n' "$1"
    cat "$2"
    printf '```\n\n'
  } >> "$GITHUB_STEP_SUMMARY"
}
