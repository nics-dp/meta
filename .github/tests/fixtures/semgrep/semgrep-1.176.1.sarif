{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"cookie-inline.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":3,"endLine":13,"snippet":{"text":"\treturn &http.Cookie{ // nosemgrep: go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure\n\t\tName:     \"session\",\n\t\tValue:    \"synthetic\",\n\t\tSecure:   secure,\n\t\tHttpOnly: true,\n\t\tSameSite: http.SameSiteLaxMode,\n\t}"},"startColumn":10,"startLine":7}}}],"message":{"text":"A session cookie was detected without setting the 'Secure' flag. The 'secure' flag for cookies prevents the client from transmitting the cookie over insecure channels such as HTTP. Set the 'Secure' flag by setting 'Secure' to 'true' in the Options struct."},"properties":{},"ruleId":"go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure","suppressions":[{"kind":"inSource"}]},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"cookie-inline.go","uriBaseId":"%SRCROOT%"},"region":{"endColumn":3,"endLine":23,"snippet":{"text":"\treturn &http.Cookie{\n\t\tName:     \"session\",\n\t\tValue:    \"synthetic\",\n\t\tSecure:   secure,\n\t\tHttpOnly: true,\n\t\tSameSite: http.SameSiteLaxMode,\n\t}"},"startColumn":10,"startLine":17}}}],"message":{"text":"A session cookie was detected without setting the 'Secure' flag. The 'secure' flag for cookies prevents the client from transmitting the cookie over insecure channels such as HTTP. Set the 'Secure' flag by setting 'Secure' to 'true' in the Options struct."},"properties":{},"ruleId":"go.lang.security.audit.net.cookie-missing-secure.cookie-missing-secure"}],"tool":{"driver":{"name":"Semgrep OSS","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"A session cookie was detected without setting the 'Secu